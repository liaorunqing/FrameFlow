# 未配置密钥时使用 demo，不会产生任何费用。
# 中国大陆生产环境推荐 MiniMax 官方开放平台：https://platform.minimaxi.com/
VIDEO_PROVIDER=minimax-official
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com
# 仅在本机代理将官方域名解析为 198.18.x.x Fake-IP 时填写；正常环境留空。
MINIMAX_API_IPS=
MINIMAX_POLL_INTERVAL_SECONDS=10
MINIMAX_TASK_TIMEOUT_SECONDS=900

# Optional local-development fallback for proxy/Fake-IP environments. Leave
# blank on a normal mainland server. When all three are set, FrameFlow restores
# the original Clash GLOBAL selection immediately after each download.
VIDEO_DOWNLOAD_PROXY_URL=
CLASH_CONTROLLER_URL=
CLASH_DOWNLOAD_NODE_MATCH=

# 可选：使用任意 OpenAI-compatible 的低成本文本模型生成非模板化剧本。
# 不配置时使用内置的生活流故事导演，仍可完整运行。
DIRECTOR_API_BASE=http://127.0.0.1:11434/v1
# Ollama does not validate this token, but it preserves OpenAI-compatible clients.
DIRECTOR_API_KEY=ollama
DIRECTOR_MODEL=qwen3:latest
DIRECTOR_TIMEOUT_SECONDS=180
# none is much faster on an 8 GB laptop GPU; use low for deeper story exploration.
DIRECTOR_REASONING_EFFORT=none

# Cloud-only AI configuration (recommended for deployment on another computer).
# The same DashScope key can power both script generation and visual analysis.
DASHSCOPE_API_KEY=
DIRECTOR_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DIRECTOR_API_KEY=
DIRECTOR_MODEL=qwen3.6-flash
VISION_PROVIDER=dashscope
VISION_CLOUD_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_CLOUD_API_KEY=
VISION_CLOUD_MODEL=qwen3.7-plus
# Keep automated judging separate from asset analysis to reduce correlated errors.
VISION_REVIEW_MODEL=qwen3.6-flash
VISION_TIMEOUT_SECONDS=240

# Optional local fallback. These are ignored while VISION_PROVIDER=dashscope.
VISION_API_BASE=http://127.0.0.1:11434
VISION_MODEL=qwen3-vl:4b
VISION_REVIEW_LOCAL_MODEL=qwen3-vl:4b

# 成片与素材建议在生产环境迁移到自有对象存储。
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
